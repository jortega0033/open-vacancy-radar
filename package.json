{
  "name": "agent-dock",
  "private": true,
  "version": "0.1.0",
  "description": "Open Vacancy Radar desktop job-search workspace built on the AgentDock local runtime",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jortega0033/open-vacancy-radar.git"
  },
  "homepage": "https://github.com/jortega0033/open-vacancy-radar#readme",
  "bugs": {
    "url": "https://github.com/jortega0033/open-vacancy-radar/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:daemon": "pnpm --filter @agent-dock/daemon run dev",
    "dev:desktop": "pnpm --filter @agent-dock/desktop run dev",
    "daemon": "pnpm --filter @agent-dock/daemon run start",
    "package": "pnpm build && pnpm --filter @agent-dock/desktop run package",
    "package:win": "pnpm build && pnpm --filter @agent-dock/desktop run package:win",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/* run test",
    "test:provider-conformance": "pnpm --filter @agent-dock/agent-runtime exec vitest run test/claude-contract.test.ts test/codex-contract.test.ts test/claude-supervisor-contract.test.ts test/codex-supervisor-contract.test.ts test/compatibility-manifest.test.ts test/accepted-work.test.ts test/launch-scope.test.ts test/fallback-gate.test.ts test/unknown-frames.test.ts test/session-supervisor.test.ts",
    "test:windows-process-tree": "pnpm --filter @agent-dock/agent-runtime exec vitest run test/spawn-process.test.ts",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets:generate": "python scripts/assets/generate_assets.py",
    "assets:validate": "python scripts/assets/validate_assets.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "vite": "^6.0.7",
      "@types/node": "^22.10.5",
      "tar": "^7.5.18",
      "esbuild": "^0.25.0",
      "electron-builder-squirrel-windows": "^26.15.3",
      "app-builder-lib": "^26.15.3",
      "builder-util-runtime": "^9.7.0"
    }
  }
}
