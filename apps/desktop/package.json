{
  "name": "@agent-dock/desktop",
  "version": "0.1.0",
  "description": "Open Vacancy Radar desktop application",
  "author": "Open Vacancy Radar contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "package": "electron-builder",
    "package:win": "electron-builder --win nsis",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "workspace:db:generate": "drizzle-kit generate --config drizzle.workspace.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@agent-dock/client": "workspace:*",
    "@agent-dock/shared": "workspace:*",
    "@electron/rebuild": "^3.7.1",
    "@open-vacancy-radar/vacancy-engine": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.7.22",
    "docx": "^9.7.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "unpdf": "^1.8.1",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.6"
  }
}
