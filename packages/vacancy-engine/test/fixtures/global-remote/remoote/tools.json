{
  "tools": [
    {
      "name": "search_jobs",
      "auth_required": false,
      "public_limit": 10,
      "rest_endpoint": "POST /remoote/agents/search_jobs",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "default": null, "maxLength": 200 },
          "role_title": { "default": null, "maxLength": 200 },
          "skills": { "default": null, "maxItems": 20 },
          "exclude_skills": { "default": null, "maxItems": 20 },
          "country": { "default": null, "maxLength": 100 },
          "region": { "default": null, "maxLength": 80 },
          "location_tag": { "default": null, "maxLength": 80 },
          "seniority": { "default": null, "maxItems": 10 },
          "employment_type": { "default": null, "maxItems": 10 },
          "salary_required": { "default": true, "type": "boolean" },
          "limit": { "default": 10, "minimum": 1, "maximum": 25, "type": "integer" }
        }
      }
    },
    {
      "name": "get_job",
      "auth_required": false,
      "public_limit": null,
      "rest_endpoint": "GET /remoote/agents/jobs/{job_id}",
      "input_schema": {
        "type": "object",
        "required": ["job_id"],
        "properties": {
          "job_id": { "exclusiveMinimum": 0, "type": "integer" }
        }
      }
    }
  ],
  "mcp_endpoint": "/remoote/agents/mcp",
  "rest_prefix": "/remoote/agents",
  "public_limits": {
    "max_results_per_call": 10,
    "max_authenticated_results_per_call": 25,
    "bulk_export": false,
    "raw_employer_apply_urls": false
  }
}
