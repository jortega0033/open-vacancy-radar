# Embedded SQLite database file. Resolved relative to the project root and
# required to stay inside it. No external database server is needed.
DATABASE_PATH=.data/vacancy-engine.db

SCAN_BATCH_SIZE=50
GLOBAL_CONCURRENCY=6
PER_DOMAIN_CONCURRENCY=1
REQUEST_TIMEOUT_MS=15000
REQUEST_QUEUE_TIMEOUT_MS=120000
MAX_RESPONSE_BYTES=16777216
MAX_RETRIES=2
HTTP_CACHE_DIR=.cache/http
HTTP_CACHE_RETENTION_DAYS=90
SPONSOR_BASELINE_MAX_AGE_DAYS=45
USER_AGENT=INDJobRadar/0.1 (+personal vacancy research; contact: configure-your-email)

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional sanctioned employer-domain discovery. Never loaded from other machine credentials.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BATCH_SIZE=25
BRAVE_SEARCH_MAX_REQUESTS=25
BRAVE_SEARCH_RECHECK_DAYS=30

# Optional global-remote keyed discovery sources. Each stays configuration_required
# (adapter implemented but not run) until its own key is set here.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
REED_API_KEY=
JOBSPIPE_API_KEY=

LOG_LEVEL=info
REPORT_MIN_SCORE=70
MAX_POSTING_AGE_DAYS=365
