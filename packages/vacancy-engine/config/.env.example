# Environment schema for the vacancy-engine CLI (see ../src/config.ts:16-62).
# Copy this file to .env in the directory you run `pnpm scan` / `pnpm roster-import` /
# `pnpm sponsor-sync` from (the vacancy-engine package root, or the repo root if you rely on
# `pnpm --filter` scripts and dotenv's default cwd resolution), then fill in real values where
# a placeholder below isn't good enough on its own. Every key has a working default in config.ts,
# so an empty .env still runs -- this file exists to make each key discoverable, not required.

# --- Storage ---------------------------------------------------------------
DATABASE_PATH=.data/vacancy-engine.db
HTTP_CACHE_DIR=.cache/http
HTTP_CACHE_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=90

# --- Scan throughput and networking ----------------------------------------
SCAN_BATCH_SIZE=50
GLOBAL_CONCURRENCY=6
PER_DOMAIN_CONCURRENCY=1
REQUEST_TIMEOUT_MS=15000
REQUEST_QUEUE_TIMEOUT_MS=120000
MAX_RESPONSE_BYTES=16777216
MAX_RETRIES=2
USER_AGENT=OpenVacancyRadar/0.1 (+personal vacancy research; contact: you@example.com)

# --- IND sponsor check -------------------------------------------------------
SPONSOR_BASELINE_MAX_AGE_DAYS=45

# --- AI-assisted classification (optional; leave AI_ENABLED=false to skip) --
AI_ENABLED=false
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-your-own-key
AI_MODEL=your-model-id

# --- Brave Search discovery (optional) --------------------------------------
BRAVE_SEARCH_API_KEY=replace-with-your-own-key
BRAVE_SEARCH_BATCH_SIZE=25
BRAVE_SEARCH_MAX_REQUESTS=25
BRAVE_SEARCH_RECHECK_DAYS=30

# --- Keyed job-board API discovery (optional; each source is skipped if blank) --
ADZUNA_APP_ID=replace-with-your-own-id
ADZUNA_APP_KEY=replace-with-your-own-key
JOOBLE_API_KEY=replace-with-your-own-key
REED_API_KEY=replace-with-your-own-key
JOBSPIPE_API_KEY=replace-with-your-own-key
NAV_ARBEIDSPLASSEN_API_KEY=replace-with-your-own-key

# --- Logging and reporting ---------------------------------------------------
LOG_LEVEL=info
REPORT_MIN_SCORE=70
MAX_POSTING_AGE_DAYS=365
