# Generated scan reports (HTML/JSON/NDJSON) — regenerated by every scan, not checked in
packages/vacancy-engine/reports/*
!packages/vacancy-engine/reports/.gitkeep

# Playwright e2e run output — regenerated by every run; baseline screenshots under
# apps/desktop/e2e/**/*-snapshots/ are checked in intentionally and are not excluded here.
apps/desktop/playwright-report/
apps/desktop/test-results/
